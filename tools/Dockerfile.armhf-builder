# Cross-compiler image for vst/build_so.sh. Build once: docker build -t md-armhf-builder-glibc231 -f tools/Dockerfile.armhf-builder .
# debian:bullseye's crossbuild-essential-armhf targets glibc 2.31: the plugin then loads on MPC OS 2.x (glibc 2.32) as well
# as 3.x (2.39). bookworm (2.36) does not load on 2.x. bullseye's cmake (3.18) is too old for the root CMakeLists (3.22), so
# cmake comes from pip. bullseye is end-of-life: its packages now live on archive.debian.org.
FROM debian:bullseye
RUN printf 'deb http://archive.debian.org/debian bullseye main\n' > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --allow-downgrades perl-base=5.32.1-4+deb11u3 \
    && apt-get install -y --no-install-recommends --allow-downgrades \
    crossbuild-essential-armhf ninja-build git file ca-certificates python3-pip \
    && pip3 install --no-cache-dir 'cmake>=3.22,<4' \
    && rm -rf /var/lib/apt/lists/*
ENV CROSS_PREFIX=arm-linux-gnueabihf-
