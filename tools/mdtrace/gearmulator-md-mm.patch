+	void Microcontroller::traceBreakpoint()
+	{
+		const auto pc = getPC();
+		for(uint32_t i = 0; i < g_mdBpCount; ++i)
+		{
+			if(g_mdBp[i] != pc) continue;
+			std::fprintf(stderr, "BP pc=%06x cyc=%llu a=", pc, static_cast<unsigned long long>(getCycles()));
+			for(uint32_t r = 0; r < 8; ++r) std::fprintf(stderr, "%08x ", getAReg(r));
+			std::fprintf(stderr, "d=");
+			for(uint32_t r = 0; r < 8; ++r) std::fprintf(stderr, "%08x ", getDReg(r));
+			const uint32_t base = g_mdBpDumpReg < 8 ? getDReg(g_mdBpDumpReg) : getAReg(g_mdBpDumpReg - 8);
+			std::fprintf(stderr, "mem[%08x]=", base);
+			for(uint32_t k = 0; k < g_mdBpDumpLen; k += 2)
+			{
+				const auto r = resolve(base + k);
+				std::fprintf(stderr, "%04x ", (r.data && !r.peripheral && r.offset + 2 <= r.size) ? (uint32_t(r.data[r.offset]) << 8 | r.data[r.offset + 1]) : 0xdead);
+			}
+			std::fprintf(stderr, "\n");
+		}
+	}
